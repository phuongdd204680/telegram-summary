# =====================================================================
# CẤU HÌNH TELEGRAM BOT VÀ TÓM TẮT TIN NHẮN (TELEGRAM MESSAGE SUMMARIZER)
# =====================================================================

# 1. Telegram Bot API token (Lấy từ @BotFather trên Telegram)
# Dùng để khởi chạy bot nhận lệnh /start, /summary, /status, /cancel...
TELEGRAM_BOT_TOKEN=

# 2. Telegram API credentials dành cho Telethon (Tài khoản cá nhân)
# Lấy từ trang quản trị chính thức của Telegram: https://my.telegram.org (App Development Tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Tên file session của Telethon (file này sẽ được tạo trong thư mục dự án)
# Không chia sẻ file .session cho bất kỳ ai vì nó chứa phiên đăng nhập tài khoản của bạn.
TELEGRAM_SESSION_NAME=telegram_user_session

# 3. Phân quyền người dùng
# Telegram User ID (dạng số nguyên) duy nhất được phép điều khiển bot.
# Lấy ID của bạn thông qua bot @userinfobot hoặc @myidbot trên Telegram.
# Nếu để trống, bot sẽ từ chối tất cả các yêu cầu tóm tắt và đọc tin nhắn vì lý do bảo mật.
ALLOWED_TELEGRAM_USER_ID=

# 4. OpenRouter API
# API Key lấy từ tài khoản OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model ID được chọn trên OpenRouter
# Bạn có thể kiểm tra danh sách model miễn phí cập nhật tại: https://openrouter.ai/models?max_price=0
# Ví dụ model miễn phí đang hoạt động:
#   openrouter/free (Router tự động chọn model miễn phí tốt nhất đang online)
#   nvidia/nemotron-3.5-lightning:free
#   nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# OpenRouter Base URL (Chỉ chứa base url, code sẽ tự thêm /chat/completions đúng 1 lần)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hai biến tùy chọn theo tài liệu OpenRouter để xếp hạng bảng xếp hạng ứng dụng
# HTTP-Referer: URL website hoặc repo của bạn (tùy chọn)
OPENROUTER_SITE_URL=

# X-OpenRouter-Title: Tên ứng dụng hiển thị trên trang tổng quan OpenRouter
OPENROUTER_APP_NAME=Telegram Message Summarizer

# Timeout cho yêu cầu gọi AI (tính bằng giây, mặc định 60 giây)
OPENROUTER_TIMEOUT=60

# 5. Cấu hình giới hạn an toàn khi lấy dữ liệu tin nhắn (Bảo vệ Token & Tránh quá tải)
# Số lượng cuộc trò chuyện tối đa quét trong một lượt tóm tắt
MAX_CHATS_TO_SCAN=10

# Số lượng tin nhắn tối đa lấy từ mỗi cuộc trò chuyện
MAX_MESSAGES_PER_CHAT=30

# Tổng số lượng tin nhắn tối đa gửi đến AI trong một lần tóm tắt
TOTAL_MAX_MESSAGES=150
